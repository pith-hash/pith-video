# Text files are stored and checked out with LF on every platform. This is
# not a style preference: the fixtures and the reference vectors are byte
# contracts, so a CRLF checkout would silently change their SHA-256.
* text=auto eol=lf

# Binary fixtures whose SHA-256 is part of the crate contract: ISO-BMFF
# containers, remuxed QuickTime and the raw Annex-B stream.
*.mp4 binary
*.mov binary
*.h264 binary

# The lockfile is generated by cargo and is LF by construction.
Cargo.lock text eol=lf
